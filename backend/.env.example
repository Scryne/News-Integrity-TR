# News Integrity TR — backend config template.
# Copy to backend/.env (which is gitignored) and adjust. Env vars use the NIT_
# prefix; see ARCHITECTURE.md §9 for the full table.
#
# NOTE: this is the BACKEND env file (read from the backend working dir). Any
# .env at the repository root is separate (e.g. spike secrets) and is not read
# by the backend.

# DB + evidence root (default ./data, relative to the backend working dir).
NIT_DATA_DIR=./data

# Bind port; host is hardcoded to 127.0.0.1 (ADR-014).
NIT_PORT=8765

# Case-study phase: VK1 | VK2 (ADR-019). Switched to VK2 exactly once, at the
# start of sprint S2.
NIT_PHASE=VK1

# Installed (unpacked) extension id (ADR-021). Leave unset on first run; after
# loading the extension, copy its id from chrome://extensions here to lock CORS
# to exactly chrome-extension://<id>. While unset the backend starts with a
# wildcard CORS origin and logs a warning.
# NIT_EXTENSION_ID=abcdefghijklmnopabcdefghijklmnop

# --- Archive worker (ARCHITECTURE §3.4) ---
# NIT_ARCHIVE_WORKER=true
# NIT_ARCHIVE_MAX_ATTEMPTS=5
# NIT_ARCHIVE_TODAY_MIN_INTERVAL_S=45
# NIT_WAYBACK_MIN_INTERVAL_S=60
# Wayback SPN2 keys (ADR-024; archive.org -> account -> S3 keys). Without them
# Wayback jobs go to manual_pending. x.com URLs are manual-first regardless
# (ADR-025). NIT_WAYBACK_S3_ACCESS is accepted as an alias for the access key.
# NIT_WAYBACK_S3_ACCESSKEY=
# NIT_WAYBACK_S3_SECRET=

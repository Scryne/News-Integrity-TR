{
  "manifest_version": 3,
  "name": "News Integrity TR — Kanıt Yakalama",
  "short_name": "NIT Kanıt",
  "version": "0.1.0",
  "description": "X gönderilerini kodlayıp yerel backend'e doğrulanabilir kanıt olarak kaydeder. Hiçbir veri dışarı gönderilmez.",
  "minimum_chrome_version": "116",
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
